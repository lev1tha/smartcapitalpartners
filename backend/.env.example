# Скопируйте в backend/.env и заполните. Файл .env не коммитится.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# База данных. Пусто → SQLite (backend/db.sqlite3).
# Прод: postgres://user:password@host:5432/scp
DATABASE_URL=

# Откуда фронтенд ходит в API (CORS). Capacitor-приложения добавлены по умолчанию.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://smartcapitalpartners.kg

# Срок жизни токена сотрудника, дней.
AUTH_TOKEN_TTL_DAYS=30

# --- Telegram ---
# Токен бота от @BotFather (тот же, что был в backend-php/config.php).
TELEGRAM_BOT_TOKEN=
# Чат, куда падают заявки с сайта (директор). Личные уведомления сотрудников —
# по их собственному chat_id в профиле (раздел «Уведомления» в CRM).
TELEGRAM_LEADS_CHAT_ID=

# --- Email (заявки) ---
LEADS_EMAIL=eldimamaev@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=
# App Password Gmail (16 символов). Пусто → письма не отправляются.
EMAIL_HOST_PASSWORD=
EMAIL_FROM_NAME=Smart Capital Partners
